generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  Int            @id @default(autoincrement())
  email               String         @unique
  password            String         @default("xyz")
  role                Role           @default(STUDENT)
  rollNo              String?
  displayName         String?
  photoURL            String?
  admissionYear       Int?
  branchName          String?
  program             Program?
  lastseen            DateTime?
  postedAnnouncements Announcement[]
  comments            Comment[]      @relation("CommentBy")
  experiences         Experience[]
  likes               Like[]
  uploadedResources   Resource[]
  bookmarks           Bookmark[]
  wikiArticles        WikiArticle[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Experience {
  id             Int            @id @default(autoincrement())
  title          String
  description    String         @db.Text
  experienceType ExperienceType
  status         ContentStatus
  domain         String?
  resumeUrl      String?
  uploadedById   Int
  uploadedBy     User           @relation(fields: [uploadedById], references: [id])
  comments       Comment[]
  likes          Like[]
  bookmarks      Bookmark[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Bookmark {
  id        Int        @id @default(autoincrement())
  postId    Int
  post      Experience @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        Int         @id @default(autoincrement())
  content   String?
  postId    Int?
  userId    Int
  parentId  Int?
  rootId    Int?
  parent    Comment?    @relation("ParentComment", fields: [parentId], references: [id])
  replies   Comment[]   @relation("ParentComment")
  post      Experience? @relation(fields: [postId], references: [id])
  user      User        @relation("CommentBy", fields: [userId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([postId])
  @@index([rootId])
  @@index([parentId])
  @@index([postId, rootId])
}

model Like {
  id        Int         @id @default(autoincrement())
  postId    Int?
  userId    Int
  post      Experience? @relation(fields: [postId], references: [id])
  user      User        @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, postId])
  @@index([postId])
}

model Verification {
  id         Int              @id @default(autoincrement())
  email      String
  otpHash    String
  type       VerificationType
  expiringAt DateTime
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([email])
  @@index([expiringAt])
}

model Course {
  id            Int        @id @default(autoincrement())
  courseCode    String     @unique
  name          String
  description   String?
  academicYear  Int
  allowedBranch String[]
  program       Program
  credits       Decimal    @db.Decimal
  instructor    String
  resources     Resource[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Resource {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  filePath     String
  resourceType ResourceType
  uploadedById Int?
  courseId     Int?
  course       Course?      @relation(fields: [courseId], references: [id])
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Announcement {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?
  type           String   @default("GENERAL")
  isPinned       Boolean  @default(false)
  isFileAttached Boolean  @default(false)
  filePath       String?
  uploadedById   Int?
  uploadedBy     User?    @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FinanceVault {
  id                  Int               @id @default(autoincrement())
  title               String
  description         String
  category            FinanceCategory
  provider            String?
  amount              String?
  eligibilityCriteria String?
  incomeEligibility   String?
  genderEligibility   GenderEligibility @default(ALL)
  applicableBranch    String[]
  academicYear        String?
  subCategory         String[]
  state               String[]
  deadline            DateTime?
  applicationUrl      String?
  officialWebsite     String?
  requiredDocuments   String?
  attachments         Json?
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model WikiCategory {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  slug        String        @unique
  description String?
  articles    WikiArticle[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model WikiArticle {
  id          Int          @id @default(autoincrement())
  title       String
  slug        String       @unique
  content     String       @db.Text
  categoryId  Int
  category    WikiCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId    Int?
  author      User?        @relation(fields: [authorId], references: [id])
  isPublished Boolean      @default(true)
  views       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId])
  @@index([slug])
}

enum Role {
  STUDENT
  RESOURCE_ADMIN
  ANNOUNCEMENT_ADMIN
  SUPER_ADMIN
  FACULTY
  CAREER_ADMIN
  FINANCE_ADMIN
  WIKI_ADMIN
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_OTP
}

enum Program {
  MTECH
  BTECH
  PHD
  MSC
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ExperienceType {
  INTERNSHIP
  PLACEMENT
  STARTUP
}

enum ResourceType {
  NOTES
  PYQ
  TUTORIAL
  LAB_ASSIGNMENT
  LAB_MANUAL
  BOOK
  LECTURE_SLIDE
  ASSIGNMENT
  PROJECT
  SYLLABUS
  QUESTION_BANK
  REFERENCE_MATERIAL
  PRESENTATION
  VIDEO_LECTURE
  SOFTWARE
  DATASET
  READING_MATERIAL
  CASE_STUDY
  EXAM_NOTICE
  TIME_TABLE
  OTHER
}

enum FinanceCategory {
  SCHOLARSHIP
  FEE_WAIVER
  EDUCATION_LOAN
  FINANCIAL_ASSISTANCE
  GRANT
  FEE_REIMBURSEMENT
  OTHER
}

enum GenderEligibility {
  ALL
  MALE
  FEMALE
}
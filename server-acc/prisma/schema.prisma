generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_DATABASE_URL")
}

model User {
  id                  Int            @id @default(autoincrement())
  email               String         @unique
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  admissionYear       Int?
  branchName          String?
  displayName         String?
  photoURL            String?
  program             Program?
  role                Role           @default(STUDENT)
  rollNo              String?
  password            String         @default("xyz")
  lastseen            DateTime?
  postedAnnouncements Announcement[]
  comments            Comment[]      @relation("CommentBy")
  experiences         Experience[]
  likes               Like[]
  uploadedResources   Resource[]
  bookmarks           Bookmark[]

  // Research Vault (4 Models)
  researchOpenPositions       ResearchOpenPosition[] @relation("OpenPositionsUploaded")
  researchResourcesUploaded   ResearchResource[]     @relation("ResearchResourcesUploaded")
  researchResourcesApproved   ResearchResource[]     @relation("ResearchResourcesApproved")
  researchDiscussionsAuthored ResearchDiscussion[]   @relation("ResearchDiscussionsAuthored")

  doubts       Doubt[]
  doubtAnswers DoubtAnswer[]
  doubtVotes   DoubtVote[]
  doubtReports DoubtReport[]
}

model Experience {
  id             Int            @id @default(autoincrement())
  title          String
  description    String         @db.Text
  experienceType ExperienceType
  status         ContentStatus
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  uploadedById   Int
  domain         String?
  resumeUrl      String?
  comments       Comment[]
  uploadedBy     User           @relation(fields: [uploadedById], references: [id])
  likes          Like[]
  bookmarks      Bookmark[]
}

model Bookmark {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  postId    Int
  post      Experience @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        Int         @id @default(autoincrement())
  content   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  postId    Int?
  userId    Int
  parentId  Int?
  rootId    Int?
  parent    Comment?    @relation("ParentComment", fields: [parentId], references: [id])
  replies   Comment[]   @relation("ParentComment")
  post      Experience? @relation(fields: [postId], references: [id])
  user      User        @relation("CommentBy", fields: [userId], references: [id])

  @@index([postId])
  @@index([rootId])
  @@index([parentId])
  @@index([postId, rootId])
}

model Like {
  id        Int         @id @default(autoincrement())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  postId    Int?
  userId    Int
  post      Experience? @relation(fields: [postId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
  @@index([postId])
}

model Verification {
  id         Int              @id @default(autoincrement())
  email      String
  otpHash    String
  type       VerificationType
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  expiringAt DateTime

  @@index([email])
  @@index([expiringAt])
}

model Course {
  id            Int        @id @default(autoincrement())
  courseCode    String     @unique
  name          String
  description   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  academicYear  Int
  allowedBranch String[]
  program       Program
  credits       Decimal    @db.Decimal
  instructor    String
  resources     Resource[]
}

model Resource {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  filePath     String
  resourceType ResourceType
  uploadedById Int?
  courseId     Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  course       Course?      @relation(fields: [courseId], references: [id])
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])
}

model Announcement {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?
  isPinned       Boolean  @default(false)
  isFileAttached Boolean  @default(false)
  filePath       String?
  uploadedById   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  type           String   @default("GENERAL")
  uploadedBy     User?    @relation(fields: [uploadedById], references: [id])
}

model FinanceVault {
  id          Int    @id @default(autoincrement())
  title       String
  description String

  category FinanceCategory
  provider String?

  amount String?

  eligibilityCriteria String?
  incomeEligibility   String?

  genderEligibility GenderEligibility @default(ALL)

  applicableBranch String[]
  academicYear     String?

  subCategory String[]
  state       String[]

  deadline DateTime?

  applicationUrl  String?
  officialWebsite String?

  requiredDocuments String?
  attachments       Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  STUDENT
  RESOURCE_ADMIN
  ANNOUNCEMENT_ADMIN
  SUPER_ADMIN
  FACULTY
  CAREER_ADMIN
  FINANCE_ADMIN
  RESEARCH_ADMIN
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_OTP
}

enum Program {
  MTECH
  BTECH
  PHD
  MSC
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ExperienceType {
  INTERNSHIP
  PLACEMENT
  STARTUP
}

enum ResourceType {
  NOTES
  PYQ
  TUTORIAL
  LAB_ASSIGNMENT
  LAB_MANUAL
  BOOK
  LECTURE_SLIDE
  ASSIGNMENT
  PROJECT
  SYLLABUS
  QUESTION_BANK
  REFERENCE_MATERIAL
  PRESENTATION
  VIDEO_LECTURE
  SOFTWARE
  DATASET
  READING_MATERIAL
  CASE_STUDY
  EXAM_NOTICE
  TIME_TABLE
  OTHER
}

enum FinanceCategory {
  SCHOLARSHIP
  FEE_WAIVER
  EDUCATION_LOAN
  FINANCIAL_ASSISTANCE
  GRANT
  FEE_REIMBURSEMENT
  OTHER
}

enum GenderEligibility {
  ALL
  MALE
  FEMALE
}

model Roadmap {
  id          Int              @id @default(autoincrement())
  title       String
  slug        String           @unique
  description String?
  domain      String?
  icon        String?
  isPublished Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sections    RoadmapSection[]
}

model RoadmapSection {
  id        Int              @id @default(autoincrement())
  roadmapId Int
  title     String
  order     Int              @default(0)
  roadmap   Roadmap          @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  chapters  RoadmapChapter[]
}

model RoadmapChapter {
  id        Int            @id @default(autoincrement())
  sectionId Int
  title     String
  slug      String
  content   String         @db.Text
  order     Int            @default(0)
  duration  String?
  section   RoadmapSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, slug])
}

// ---------------------------------------------------------------------------
// ACC Wiki: doubt-resolution forum
// ---------------------------------------------------------------------------

model Doubt {
  id        Int           @id @default(autoincrement())
  title     String
  body      String        @db.Text
  category  String        @default("Other")
  status    DoubtStatus   @default(OPEN)
  isPinned  Boolean       @default(false)
  isLocked  Boolean       @default(false)
  isHidden  Boolean       @default(false)
  authorId  Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answers   DoubtAnswer[]
  votes     DoubtVote[]
  reports   DoubtReport[]

  @@index([authorId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
}

model DoubtAnswer {
  id         Int           @id @default(autoincrement())
  body       String        @db.Text
  isAccepted Boolean       @default(false)
  isHidden   Boolean       @default(false)
  doubtId    Int
  authorId   Int
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  doubt      Doubt         @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes      DoubtVote[]
  reports    DoubtReport[]

  @@index([doubtId])
  @@index([authorId])
}

model DoubtVote {
  id        Int          @id @default(autoincrement())
  userId    Int
  doubtId   Int?
  answerId  Int?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  doubt     Doubt?       @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  answer    DoubtAnswer? @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([userId, doubtId])
  @@unique([userId, answerId])
  @@index([doubtId])
  @@index([answerId])
}

model DoubtReport {
  id         Int               @id @default(autoincrement())
  reason     String
  status     DoubtReportStatus @default(PENDING)
  reporterId Int
  doubtId    Int?
  answerId   Int?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  reporter   User              @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  doubt      Doubt?            @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  answer     DoubtAnswer?      @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([doubtId])
  @@index([answerId])
}

enum DoubtStatus {
  OPEN
  RESOLVED
}

enum DoubtReportStatus {
  PENDING
  ACTIONED
  DISMISSED
}

// ===========================================================================
// Research Vault (Exactly 4 Models)
// ===========================================================================

enum ResearchResourceType {
  GUIDE
  PAPER
  TEMPLATE
  EXPERIENCE
}

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OpeningStatus {
  OPEN
  CLOSED
}

// 1. FACULTY DIRECTORY
model FacultyProfile {
  id                 Int      @id @default(autoincrement())
  name               String
  slug               String   @unique
  designation        String?
  department         String?
  email              String?  @unique
  phone              String?
  officeLocation     String?
  photoUrl           String?
  websiteUrl         String?
  personalWebsiteUrl String?
  googleScholarUrl   String?
  linkedinUrl        String?
  biography          String?  @db.Text
  publications       String?  @db.Text
  researchAreas      String[]
  isActive           Boolean  @default(true)
  profileViewCount   Int      @default(0)

  openings  ResearchOpenPosition[]
  resources ResearchResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([researchAreas], type: Gin)
}

// 2. OPEN RESEARCH POSITIONS
model ResearchOpenPosition {
  id                 Int           @id @default(autoincrement())
  title              String
  description        String?       @db.Text
  positionType       String        @default("RA")
  requirements       String?       @db.Text
  eligibility        String?
  positionsAvailable Int           @default(1)
  positionsFilled    Int           @default(0)
  status             OpeningStatus @default(OPEN)
  deadline           DateTime?
  applicationUrl     String?
  howToApply         String?
  researchAreas      String[]
  bookmarkedUserIds  Int[]         @default([])

  facultyId    Int?
  faculty      FacultyProfile? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  uploadedById Int
  uploadedBy   User            @relation("OpenPositionsUploaded", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facultyId])
  @@index([status, deadline])
  @@index([researchAreas], type: Gin)
}

// 3. RESEARCH RESOURCES (Guides, Papers, Templates, and Student Experiences)
model ResearchResource {
  id               Int                  @id @default(autoincrement())
  title            String
  description      String?
  type             ResearchResourceType @default(GUIDE)
  content          String?              @db.Text
  meta             Json?
  url              String?
  filePath         String?
  fileSize         Int?
  mimeType         String?
  format           String?
  sourceType       String               @default("FILE")
  status           ResourceStatus       @default(PENDING)
  rejectionReason  String?
  consentConfirmed Boolean              @default(false)
  researchAreas    String[]
  viewCount        Int                  @default(0)
  downloadCount    Int                  @default(0)

  facultyId Int?
  faculty   FacultyProfile? @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  uploadedById Int?
  uploadedBy   User?     @relation("ResearchResourcesUploaded", fields: [uploadedById], references: [id])
  approvedById Int?
  approvedBy   User?     @relation("ResearchResourcesApproved", fields: [approvedById], references: [id])
  reviewedAt   DateTime?

  discussions ResearchDiscussion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, type])
  @@index([facultyId])
  @@index([researchAreas], type: Gin)
}

// 4. RESEARCH DISCUSSIONS (Q&A, 1-Level Threaded Replies, and Resource Comments)
model ResearchDiscussion {
  id            Int      @id @default(autoincrement())
  title         String?
  content       String   @db.Text
  researchAreas String[]
  upvotes       Int      @default(0)
  voterIds      Int[]    @default([])

  resourceId Int?
  resource   ResearchResource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  parentId Int?
  parent   ResearchDiscussion?  @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ResearchDiscussion[] @relation("DiscussionReplies")

  authorId Int
  author   User @relation("ResearchDiscussionsAuthored", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resourceId])
  @@index([parentId, createdAt])
  @@index([researchAreas], type: Gin)
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_DATABASE_URL")
  schemas  = ["public", "research_vault"]
}

model User {
  id                  Int            @id @default(autoincrement())
  email               String         @unique
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  admissionYear       Int?
  branchName          String?
  displayName         String?
  photoURL            String?
  program             Program?
  role                Role           @default(STUDENT)
  rollNo              String?
  password            String         @default("xyz")
  lastseen            DateTime?
  postedAnnouncements Announcement[]
  comments            Comment[]      @relation("CommentBy")
  experiences         Experience[]
  likes               Like[]
  uploadedResources   Resource[]
  resourceViews       ResourceView[]
  approvedResources   ResearchResource[]   @relation("ApprovedResource")
  bookmarks           Bookmark[]

  // Research Vault
  researchExperiences    StudentResearchExperience[]       @relation("ResearchExperienceUploader")
  researchDiscussions    ResearchDiscussion[]
  researchDiscussionReplies ResearchDiscussionReply[]
  researchResources      ResearchResource[]
  researchPositions      ResearchOpenPosition[]
  researchInterest       ResearchInterest?
  researchFacultyFollows ResearchFacultyFollow[]
  researchAreaFollows    ResearchAreaFollow[]
  researchPositionBookmarks ResearchOpenPositionBookmark[]
  researchExperienceLikes ResearchExperienceLike[]
  researchExperienceBookmarks ResearchExperienceBookmark[]
  researchDiscussionVotes ResearchDiscussionVote[]
  researchReplyVotes     ResearchReplyVote[]
  @@schema("public")
}

model Experience {
  id             Int            @id @default(autoincrement())
  title          String
  description    String         @db.Text
  experienceType ExperienceType
  status         ContentStatus
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  uploadedById   Int
  domain         String?
  resumeUrl      String?
  comments       Comment[]
  uploadedBy     User           @relation(fields: [uploadedById], references: [id])
  likes          Like[]
  bookmarks      Bookmark[]
  @@schema("public")
}

model Bookmark {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  postId    Int
  post      Experience @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
  @@schema("public")
}

model Comment {
  id        Int         @id @default(autoincrement())
  content   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  postId    Int?
  userId    Int
  parentId  Int?
  rootId    Int?
  parent    Comment?    @relation("ParentComment", fields: [parentId], references: [id])
  replies   Comment[]   @relation("ParentComment")
  post      Experience? @relation(fields: [postId], references: [id])
  user      User        @relation("CommentBy", fields: [userId], references: [id])

  @@index([postId])
  @@index([rootId])
  @@index([parentId])
  @@index([postId, rootId])
  @@schema("public")
}

model Like {
  id        Int         @id @default(autoincrement())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  postId    Int?
  userId    Int
  post      Experience? @relation(fields: [postId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
  @@index([postId])
  @@schema("public")
}

model Verification {
  id         Int              @id @default(autoincrement())
  email      String
  otpHash    String
  type       VerificationType
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  expiringAt DateTime

  @@index([email])
  @@index([expiringAt])
  @@schema("public")
}

model Course {
  id            Int        @id @default(autoincrement())
  courseCode    String     @unique
  name          String
  description   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  academicYear  Int
  allowedBranch String[]
  program       Program
  credits       Decimal    @db.Decimal
  instructor    String
  resources     Resource[]
  @@schema("public")
}

model Resource {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  filePath     String
  resourceType ResourceType
  uploadedById Int?
  courseId     Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  course       Course?      @relation(fields: [courseId], references: [id])
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])
  @@schema("public")
}

model Announcement {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?
  isPinned       Boolean  @default(false)
  isFileAttached Boolean  @default(false)
  filePath       String?
  uploadedById   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  type           String   @default("GENERAL")
  uploadedBy     User?    @relation(fields: [uploadedById], references: [id])
  @@schema("public")
}

model FinanceVault {
  id          Int    @id @default(autoincrement())
  title       String
  description String

  category FinanceCategory
  provider String?

  amount String?

  eligibilityCriteria String?
  incomeEligibility   String?

  genderEligibility GenderEligibility @default(ALL)

  applicableBranch String[]
  academicYear     String?

  subCategory      String[]
  state            String[]

  deadline DateTime?

  applicationUrl  String?
  officialWebsite String?

  requiredDocuments String?
  attachments       Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@schema("public")
}

enum Role {
  STUDENT
  RESOURCE_ADMIN
  ANNOUNCEMENT_ADMIN
  SUPER_ADMIN
  FACULTY
  CAREER_ADMIN
  FINANCE_ADMIN
  RESEARCH_ADMIN
  @@schema("public")
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_OTP
  @@schema("public")
}

enum Program {
  MTECH
  BTECH
  PHD
  MSC
  @@schema("public")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  @@schema("public")
}

enum ExperienceType {
  INTERNSHIP
  PLACEMENT
  STARTUP
  @@schema("public")
}

enum ResourceType {
  NOTES
  PYQ
  TUTORIAL
  LAB_ASSIGNMENT
  LAB_MANUAL
  BOOK
  LECTURE_SLIDE
  ASSIGNMENT
  PROJECT
  SYLLABUS
  QUESTION_BANK
  REFERENCE_MATERIAL
  PRESENTATION
  VIDEO_LECTURE
  SOFTWARE
  DATASET
  READING_MATERIAL
  CASE_STUDY
  EXAM_NOTICE
  TIME_TABLE
  OTHER
  @@schema("public")
}

enum FinanceCategory {
  SCHOLARSHIP
  FEE_WAIVER
  EDUCATION_LOAN
  FINANCIAL_ASSISTANCE
  GRANT
  FEE_REIMBURSEMENT
  OTHER
  @@schema("public")
}

// ── Research Vault ──────────────────────────────────────────────────────────

model ResearchArea {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?

  facultyProfiles FacultyProfileResearchArea[]
  experiences     StudentResearchExperienceResearchArea[]
  discussions     ResearchDiscussionResearchArea[]
  positions       ResearchOpenPositionResearchArea[]
  resources       ResearchResourceResearchArea[]
  followers       ResearchAreaFollow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@schema("research_vault")
}

model FacultyProfile {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  designation   String?
  department    String?
  email         String?
  phone         String?
  photoURL      String?
  website       String?
  biography     String?  @db.Text
  publications  String?  @db.Text
  isActive      Boolean  @default(true)
  profileViewCount Int   @default(0)

  researchAreas FacultyProfileResearchArea[]
  experiences   StudentResearchExperience[]
  followers     ResearchFacultyFollow[]
  positions     ResearchOpenPosition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@schema("research_vault")
}

model FacultyProfileResearchArea {
  facultyProfileId Int
  researchAreaId   Int

  facultyProfile FacultyProfile @relation(fields: [facultyProfileId], references: [id], onDelete: Cascade)
  researchArea   ResearchArea   @relation(fields: [researchAreaId], references: [id], onDelete: Cascade)

  @@id([facultyProfileId, researchAreaId])
  @@schema("research_vault")
}

model StudentResearchExperience {
  id             Int      @id @default(autoincrement())
  title          String
  description    String   @db.Text
  labName        String?
  guideName      String?
  duration       String?
  prerequisites  String?
  keyLearnings   String?
  outcome        String?
  status         ContentStatus @default(DRAFT)
  facultyId      Int?

  faculty  FacultyProfile?               @relation(fields: [facultyId], references: [id])
  uploadedById Int
  uploadedBy   User                       @relation("ResearchExperienceUploader", fields: [uploadedById], references: [id])
  researchAreas StudentResearchExperienceResearchArea[]
  likes         ResearchExperienceLike[]
  bookmarks     ResearchExperienceBookmark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@schema("research_vault")
}

model StudentResearchExperienceResearchArea {
  experienceId  Int
  researchAreaId Int

  experience   StudentResearchExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  researchArea ResearchArea              @relation(fields: [researchAreaId], references: [id], onDelete: Cascade)

  @@id([experienceId, researchAreaId])
  @@schema("research_vault")
}

model ResearchExperienceLike {
  id           Int @id @default(autoincrement())
  experienceId Int
  userId       Int

  experience StudentResearchExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  user       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([experienceId, userId])
  @@schema("research_vault")
}

model ResearchExperienceBookmark {
  id           Int @id @default(autoincrement())
  experienceId Int
  userId       Int

  experience StudentResearchExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  user       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([experienceId, userId])
  @@schema("research_vault")
}

model ResearchDiscussion {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  isResolved Boolean  @default(false)
  uploadedById Int
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  researchAreas ResearchDiscussionResearchArea[]
  replies       ResearchDiscussionReply[]
  votes         ResearchDiscussionVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt, id])
  @@index([isResolved, createdAt, id])
  @@schema("research_vault")
}

model ResearchDiscussionResearchArea {
  discussionId   Int
  researchAreaId Int

  discussion   ResearchDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  researchArea ResearchArea       @relation(fields: [researchAreaId], references: [id], onDelete: Cascade)

  @@id([discussionId, researchAreaId])
  @@index([researchAreaId, discussionId])
  @@schema("research_vault")
}

model ResearchDiscussionReply {
  id           Int      @id @default(autoincrement())
  content      String   @db.Text
  discussionId Int
  parentId     Int?
  uploadedById Int
  isAccepted   Boolean  @default(false)

  discussion ResearchDiscussion         @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  parent     ResearchDiscussionReply?   @relation("ReplyParent", fields: [parentId], references: [id])
  replies    ResearchDiscussionReply[]  @relation("ReplyParent")
  uploadedBy User                       @relation(fields: [uploadedById], references: [id])
  votes      ResearchReplyVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([discussionId, parentId, createdAt])
  @@schema("research_vault")
}

model ResearchDiscussionVote {
  id           Int @id @default(autoincrement())
  discussionId Int
  userId       Int
  value        Int @default(1)

  discussion ResearchDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId])
  @@schema("research_vault")
}

model ResearchReplyVote {
  id      Int @id @default(autoincrement())
  replyId Int
  userId  Int
  value   Int @default(1)

  reply ResearchDiscussionReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@schema("research_vault")
}

model ResearchResource {
  id               Int         @id @default(autoincrement())
  title            String
  description      String?
  url              String?
  filePath         String?
  fileSize         Int?
  mimeType         String?
  resourceType     String      @default("GUIDE")
  format           String?
  // Where the payload lives: a file we host (MinIO) or an external URL.
  // sourceType is authoritative; format/url/filePath are derived context.
  sourceType       String      @default("FILE")
  status           ResourceStatus @default(PENDING)
  rejection_reason String?
  consent_confirmed Boolean    @default(false)

  viewCount       Int          @default(0)
  downloadCount   Int          @default(0)

  uploadedById    Int?
  uploadedBy      User?        @relation(fields: [uploadedById], references: [id])
  approvedById    Int?
  approvedBy      User?        @relation("ApprovedResource", fields: [approvedById], references: [id])
  reviewedAt      DateTime?

  views           ResourceView[]
  customArea      CustomResearchArea?

  researchAreas ResearchResourceResearchArea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@schema("research_vault")
}

// Custom research areas submitted by users in the Submit Resource modal.
// Flagged for admin review; normalized (renamed/merged into ResearchArea or
// rejected) by an admin before becoming filterable app-wide.
model CustomResearchArea {
  id         Int      @id @default(autoincrement())
  name       String
  resourceId Int?     @unique
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt  DateTime @default(now())

  resource ResearchResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([status])
  @@schema("research_vault")
}

model ResourceView {
  id         Int      @id @default(autoincrement())
  resourceId Int
  userId     Int
  createdAt  DateTime @default(now())

  resource ResearchResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
  @@schema("research_vault")
}

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
  @@schema("research_vault")
}

model ResearchResourceResearchArea {
  resourceId     Int
  researchAreaId Int

  resource     ResearchResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  researchArea ResearchArea     @relation(fields: [researchAreaId], references: [id], onDelete: Cascade)

  @@id([resourceId, researchAreaId])
  @@schema("research_vault")
}

model ResearchOpenPosition {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?  @db.Text
  positionType    String   @default("RA")
  eligibility     String?
  applicationUrl  String?
  applicationInstructions String? @db.Text
  deadline        DateTime?
  isActive        Boolean  @default(true)
  facultyId       Int?

  faculty  FacultyProfile? @relation(fields: [facultyId], references: [id])
  uploadedById Int
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  researchAreas ResearchOpenPositionResearchArea[]
  bookmarkedBy  ResearchOpenPositionBookmark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@schema("research_vault")
}

model ResearchOpenPositionResearchArea {
  positionId     Int
  researchAreaId Int

  position      ResearchOpenPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  researchArea  ResearchArea         @relation(fields: [researchAreaId], references: [id], onDelete: Cascade)

  @@id([positionId, researchAreaId])
  @@schema("research_vault")
}

model ResearchOpenPositionBookmark {
  id        Int      @id @default(autoincrement())
  positionId Int
  userId    Int
  createdAt DateTime @default(now())

  position ResearchOpenPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([positionId, userId])
  @@schema("research_vault")
}

model ResearchInterest {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  department   String?
  subArea      String?
  projectType  String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@schema("research_vault")
}

model ResearchFacultyFollow {
  id             Int @id @default(autoincrement())
  userId         Int
  facultyProfileId Int

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  facultyProfile FacultyProfile @relation(fields: [facultyProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, facultyProfileId])
  @@schema("research_vault")
}

model ResearchAreaFollow {
  id             Int @id @default(autoincrement())
  userId         Int
  researchAreaId Int

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  researchArea ResearchArea @relation(fields: [researchAreaId], references: [id], onDelete: Cascade)

  @@unique([userId, researchAreaId])
  @@schema("research_vault")
}

enum GenderEligibility {
  ALL
  MALE
  FEMALE
  @@schema("public")
}

model Roadmap {
  id          Int              @id @default(autoincrement())
  title       String
  slug        String           @unique
  description String?
  domain      String?
  icon        String?
  isPublished Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sections    RoadmapSection[]
  @@schema("public")
}

model RoadmapSection {
  id        Int              @id @default(autoincrement())
  roadmapId Int
  title     String
  order     Int              @default(0)
  roadmap   Roadmap          @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  chapters  RoadmapChapter[]
  @@schema("public")
}

model RoadmapChapter {
  id        Int            @id @default(autoincrement())
  sectionId Int
  title     String
  slug      String
  content   String         @db.Text
  order     Int            @default(0)
  duration  String?
  section   RoadmapSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, slug])
  @@schema("public")
}

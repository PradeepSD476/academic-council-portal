# Copy to .env and fill in values. Never commit .env.

# ── Existing portal settings ──
POSTGRES_DATABASE_URL=
PORT=3000
CLIENT_URL=
SECRET_KEY=
NODE_ENV=
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=
PUBLIC_DOMAIN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── Careers: job & internship fetcher ──
CAREERS_TZ=Asia/Kolkata
# LLM provider for extracting fields from student-submitted links: "ollama" (local), "groq" (cloud, testing) or "gemini" (cloud)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# ollama: qwen2.5:7b  |  groq: openai/gpt-oss-120b  |  gemini: gemini-3.1-flash-lite
CAREERS_LLM_FAST_MODEL=
# ollama / groq: leave empty (no escalation)  |  gemini: gemini-3.8-flash
CAREERS_LLM_STRONG_MODEL=
# Only when LLM_PROVIDER=gemini. Server-side only; never a VITE_* variable.
GEMINI_API_KEY=
# Only when LLM_PROVIDER=groq. Server-side only; never a VITE_* variable.
GROQ_API_KEY=

# Local development only (scripts/careers/seedLocalDev.js)
DEV_SEED_PASSWORD=

# ── Exam reminders: no UI; safe defaults send no mail ──
EXAM_REMINDERS_ENABLED=false
EXAM_REMINDERS_SEND_ENABLED=false
EXAM_REMINDERS_DRY_RUN=true
# Optional path to a JSON registry; default config/exams/datasets.json
EXAM_REMINDERS_CONFIG=
EXAM_REMINDERS_SEND_AT=07:30
EXAM_REMINDERS_ADMIN_EMAIL=
# Defaults to SMTP_USER if blank
EXAM_REMINDERS_FROM=
EXAM_REMINDERS_TEST_MODE=false
EXAM_REMINDERS_TEST_ROLLS=
EXAM_REMINDERS_TEST_EMAILS=
# Set the supplied view-only Google Sheet link here. Keep the URL in env/config.
EXAM_ENDSEM_SHEET_URL=
# Bundled fallback: /app/data/exams/endsem.xlsx (or a path beside a custom registry)
EXAM_ENDSEM_FALLBACK_PATH=

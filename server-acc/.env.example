# Copy to .env and fill in values. Never commit .env.

# ── Existing portal settings ──
POSTGRES_DATABASE_URL=
PORT=3000
CLIENT_URL=
SECRET_KEY=
NODE_ENV=
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=
PUBLIC_DOMAIN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── Careers: job & internship fetcher ──
CAREERS_TZ=Asia/Kolkata
# LLM provider for extracting fields from student-submitted links: "ollama" (local) or "gemini"
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# ollama: qwen2.5:7b  |  gemini: gemini-3.1-flash-lite
CAREERS_LLM_FAST_MODEL=
# ollama: leave empty (no escalation)  |  gemini: gemini-3.8-flash
CAREERS_LLM_STRONG_MODEL=
# Only when LLM_PROVIDER=gemini. Server-side only; never a VITE_* variable.
GEMINI_API_KEY=

# Local development only (scripts/careers/seedLocalDev.js)
DEV_SEED_PASSWORD=

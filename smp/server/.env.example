PORT=3000

# Database Configuration
# Inside Docker (docker-compose): mongodb://smp-mongo:27017/mydb?authSource=admin&directConnection=true
# For local dev: mongodb://localhost:27017/mydb?authSource=admin&directConnection=true
DATABASE_URL="mongodb://smp-mongo:27017/mydb?authSource=admin&directConnection=true"

# MinIO Configuration for Media
# Inside Docker: "minio-acc"
# For local dev: "localhost"
MINIO_ENDPOINT="minio-acc"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_BUCKET_NAME="smp-media"

# SMTP Configuration for Email Verification

# JWT Secret for Session Management
JWT_SECRET="fallback_secret"

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173, http://localhost"

# Public Domain for MinIO media URLs (Nginx reverse proxy)
PUBLIC_DOMAIN="http://localhost"

# Anti-Abuse & Rate Limiting Settings
OTP_COOLDOWN_SECONDS=60
OTP_EXPIRY_MINUTES=10
OTP_RATE_LIMIT_WINDOW_MS=900000
OTP_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
